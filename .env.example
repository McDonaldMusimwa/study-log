# Copy to .env. Docker Compose and the API both read it.

# PostgreSQL. Compose creates this database; the API runs migrations on start.
POSTGRES_USER=study
POSTGRES_PASSWORD=study
POSTGRES_DB=study_log
# Local dev talks to the Compose database on port 5433.
DATABASE_URL=postgres://study:study@localhost:5433/study_log

# Claude drafts the LinkedIn posts. Without a key the app falls back to a template.
ANTHROPIC_API_KEY=

# Lists the day's AI Trainer commits on the wrap-up screen.
# Optional for a public repo; a fine-grained token with read access avoids rate limits.
GITHUB_TOKEN=
GITHUB_REPO=McDonaldMusimwa/Aitrainer
