# Copy to .env for local development and Docker.
# On Netlify, set the same names under Site configuration → Environment variables.

# SQLite. Locally a file; on Netlify a Turso database (libsql://<db>-<org>.turso.io) plus its token.
DATABASE_URL=file:study-log.db
DATABASE_AUTH_TOKEN=

# The password for the login screen. Required on Netlify; leave empty locally to skip the login.
APP_PASSWORD=

# Claude drafts the LinkedIn posts. Without a key the app falls back to a template.
ANTHROPIC_API_KEY=

# Lists the day's AI Trainer commits on the wrap-up screen.
# Optional for a public repo; a fine-grained token with read access avoids rate limits.
GITHUB_TOKEN=
GITHUB_REPO=McDonaldMusimwa/Aitrainer
