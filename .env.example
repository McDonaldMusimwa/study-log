# Copy to .env for local development and Docker.
# On Netlify, set the same names under Site configuration → Environment variables.

# SQLite. Locally a file; on Netlify a Turso database (libsql://<db>-<org>.turso.io) plus its token.
DATABASE_URL=file:study-log.db
DATABASE_AUTH_TOKEN=

# Optional: a password turns on the login screen. Leave empty for no login.
APP_PASSWORD=

# AI that drafts and polishes the LinkedIn posts. Groq is free (no card): get a key at console.groq.com/keys.
# Without a key the wrap-up fills in a template and the Polish button stays off.
GROQ_API_KEY=
# Optional: any chat model Groq serves; the default is a good writer on the free tier.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional and paid: used only when GROQ_API_KEY is empty.
ANTHROPIC_API_KEY=

# Lists the day's AI Trainer commits on the wrap-up screen.
# Optional for a public repo; a fine-grained token with read access avoids rate limits.
GITHUB_TOKEN=
GITHUB_REPO=McDonaldMusimwa/Aitrainer
